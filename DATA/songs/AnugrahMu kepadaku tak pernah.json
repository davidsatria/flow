{
  "title": "AnugrahMu kepadaku tak pernah",
  "lyrics": [
    {
      "type": "v",
      "text": "AnugrahMu kepadaku\ntak pernah berubah",
      "newGroup": true
    },
    {
      "type": "v",
      "text": "PerbuatanMu terlukiskan\ndi dalam hatiku",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Tercengangku dibuatMu\nkagum padaMu",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Tak ada hal di hidupku\nterluput dariMu",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Kau indah, Kau mulia\ntiada sepertiMu",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Ku ingin hidupku\nmenyenangkanMu",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Kau terawal dan terakhir\npencipta sgalanya",
      "newGroup": true
    },
    {
      "type": "v",
      "text": "Sluruh bintang pun bersinar\noleh ucapanMu",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Engkau pun mengasihiku\npenulis hidupku",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Tak henti segnap nafasku\nmenyembahMu slalu",
      "newGroup": false
    },
    {
      "type": "b",
      "text": "Kau indah, Kau mulia, tiada sepertiMu\nKu ingin hidupku menyenangkanMu",
      "newGroup": true
    },
    {
      "type": "c",
      "text": "Sgala puji, sgala hormat\nSegnap hatiku menyembahMu",
      "newGroup": true
    },
    {
      "type": "c",
      "text": "Terimalah segnap hidupku\nSbagai persembahan yang hidup",
      "newGroup": false
    },
    {
      "type": "b",
      "text": "Bukan kehendakku, namun kehendakMu\nHidupku bagiMu",
      "newGroup": true
    },
    {
      "type": "b",
      "text": "Kau indah, kau mulia\nKuingin hidupku menyenangkanMu",
      "newGroup": false
    }
  ]
}