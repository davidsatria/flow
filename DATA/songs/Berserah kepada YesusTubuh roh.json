{
  "title": "Berserah kepada YesusTubuh roh",
  "lyrics": [
    {
      "type": "v",
      "text": "Berserah kepada Yesus\nTubuh, roh dan jiwaku",
      "newGroup": true
    },
    {
      "type": "v",
      "text": "Kukasihi, kupercaya\nKuikuti Dia t'rus",
      "newGroup": false
    },
    {
      "type": "c",
      "text": "Aku berserah, aku berserah\nKepada-Mu, Jurus'lamat",
      "newGroup": true
    },
    {
      "type": "c",
      "text": "Aku berserah",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Berserah kepada Yesus\nDi kaki-Nya 'ku sujud",
      "newGroup": true
    },
    {
      "type": "v",
      "text": "Nikmat dunia kutinggalkan\nTuhan, t'rima anak-Mu",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Berserah kepada Yesus\nAku jadi milik-Mu",
      "newGroup": true
    },
    {
      "type": "v",
      "text": "B'rilah Roh-Mu meyakinkan\nBahwa Kau pun milikku",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Berserah kepada Yesus\nKuberikan diriku",
      "newGroup": true
    },
    {
      "type": "v",
      "text": "B'ri kasih-Mu dan kuasa-Mu\nYa, berkati anak-Mu",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Berserah kepada Yesus\nKurasakan api-Nya",
      "newGroup": true
    },
    {
      "type": "v",
      "text": "Kar'na s'lamat yang sempurna\nPuji, puji nama-Nya",
      "newGroup": false
    }
  ]
}