{
  "title": "Apapun yang terjadidalam hidupku",
  "lyrics": [
    {
      "type": "v",
      "text": "Apapun yang terjadi\nDalam hidupku ini",
      "newGroup": true
    },
    {
      "type": "v",
      "text": "Tak pernah kuragukan\nKasihmu tuhan",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Lewat gunung yang tinggi\nDalam lembah yang curam",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Tak pernah kuragukan\nJanjimu tuhan",
      "newGroup": false
    },
    {
      "type": "c",
      "text": "Kau berfirman dan sembuhkanku\nKau bersabda dan s'lamatkanku",
      "newGroup": true
    },
    {
      "type": "c",
      "text": "Tiada yang mustahil bagimu\nYesus kupercaya padamu",
      "newGroup": false
    }
  ]
}
