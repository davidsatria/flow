{
  "title": "Ku SiapkanHatiku TuhanTuk Deng",
  "lyrics": [
    {
      "type": "v",
      "text": "Ku Siapkan\nHatiku Tuhan",
      "newGroup": true
    },
    {
      "type": "v",
      "text": "Tuk Dengar\nFirman-Mu Saat Ini",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Ku Sujud\nMenyembah-Mu Tuhan",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Masuk Hadirat-Mu\nSaat Ini",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Curahkan\nUrapan-Mu Tuhan",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Bagi Jemaat-Mu\nSaat Ini",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Ku Siapkan Hatiku Tuhan\nTuk Dengar Firman-Mu",
      "newGroup": false
    },
    {
      "type": "c",
      "text": "Firman-Mu Tuhan\nTiada Berubah",
      "newGroup": true
    },
    {
      "type": "v",
      "text": "Dahulu Sekarang\nSelama Lamanya Tiada Berubah",
      "newGroup": true
    },
    {
      "type": "v",
      "text": "Firman-Mu Tuhan\nPenolong Hidupku",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Ku Siapkan Hatiku Tuhan\nTuk Dengar Firman-Mu",
      "newGroup": false
    }
