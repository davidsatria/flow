      "type": "v",
      "text": "Dengan\nkuasa NamaNya",
      "newGroup": false
    },
    {
      "type": "c",
      "text": "Nama Yesus menara yang kuat\nNama Yesus kota benteng yang teguh",
      "newGroup": true
    },
    {
      "type": "c",
      "text": "Nama Yesus\nkalahkan semua musuh",
      "newGroup": false
    },
    {
