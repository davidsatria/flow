{
  "title": "Saat Ku Masuk ke Hadirat-Mu",
  "lyrics": [
    {
      "type": "v",
      "text": "Saat ku masuk\nkehadirat-Mu",
      "newGroup": true
    },
    {
      "type": "v",
      "text": "Ku tersungkur\ndan sembah-Mu",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Ku persembahkan\nkorban syukurku",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Yang terbaik\nbagi-Mu",
      "newGroup": false
    },
    {
      "type": "c",
      "text": "Ku bawa\nkorban syukur",
      "newGroup": true
    },
    {
      "type": "c",
      "text": "Ke tempat\nkudus-Mu Tuhan",
      "newGroup": false
    },
    {
      "type": "c",
      "text": "Hatiku limpah\ndengan syukur",
      "newGroup": false
    },
    {
      "type": "c",
      "text": "Sbab Tuhan baik\nSelamanya",
      "newGroup": false
    },
    {
      "type": "e",
      "text": "Sbab Tuhan baik\nOo  sbab Tuhan baik",
      "newGroup": true
    }
  ]
}