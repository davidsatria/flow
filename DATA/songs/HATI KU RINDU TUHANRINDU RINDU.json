{
  "title": "HATI KU RINDU TUHANRINDU RINDU",
  "lyrics": [
    {
      "type": "v",
      "text": "HATI KU RINDU TUHAN",
      "newGroup": true
    },
    {
      "type": "v",
      "text": "RINDU RINDU MELAYANI",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "KU BERIKAN HANYA PADA-MU",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "JIWA KU RINDU TUHAN",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "S'LALU DALAM HADIRAT-MU",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "AGAR HIDUP KU TUHAN",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "LAYAK\nDI HADAPAN-MU",
      "newGroup": false
    },
    {
      "type": "c",
      "text": "KU PUJI KU PUJI\nKU PUJILAH\nNAMA TUHAN",
      "newGroup": true
    },
    {
      "type": "v",
      "text": "KU SEMBAH\nKU SEMBAH",
      "newGroup": true
    },
    {
      "type": "v",
      "text": "KU SEMBAH DAN MULIAKAN",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "BUNYIKAN BUNYIKAN",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "BUNYIKANLAH GAMBUS-MU",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "MENARI MENARI MENARI dan MENARILAH",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "T'RIMALAH PUJIANKU",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "JADIKANLAH KAMI BERKAT",
      "newGroup": false
    }
  ]
