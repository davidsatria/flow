{
  "title": "S'bab Kau LayakT'rima PujianS'bab",
  "lyrics": [
    {
      "type": "c",
      "text": "S'bab Kau Layak\nT'rima Pujian",
      "newGroup": true
    },
    {
      "type": "v",
      "text": "S'bab Kau Layak\nT'rima Pujian",
      "newGroup": true
    },
    {
      "type": "v",
      "text": "S'bab Kau Layak\nKuagungkan Yesus",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Raja Di Atas Segala Raja",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Mulia sembah Raja Mulia",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Bagi Yesus puji hormat\ndan kuasa",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Mulia agung K'rajaan-Nya",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Dari surga datang untuk\ns'gnap umat-Nya",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Dipuji, ditinggikan\nnama-Nya Yesus",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Hormat dan muliakanlah\nYesus Raja",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Mulia, sembah Raja Mulia",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Dia t'lah lahir,\ndimuliakan jadi Raja",
      "newGroup": false
    },
    {
      "type": "c",
      "text": "Sembah dan puji Dia\nSembah dan puji Dia",
      "newGroup": true
    },
    {
      "type": "v",
      "text": "Sembah dan puji Dia\nSang Raja",
      "newGroup": true
    }
  ]
}