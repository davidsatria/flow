    {
      "type": "c",
      "text": "Kau buktikan\nkesetiaan-Mu, Tuhan",
      "newGroup": false
    },
    {
      "type": "c",
      "text": "Engkau Allah Imanuel",
      "newGroup": false
    },
    {
      "type": "b",
      "text": "Imanuel, Imanuel\nEngkau besertaku",
      "newGroup": true
    },
    {
