{
  "title": "Tiada terukur besarkasih setia-Mu",
  "lyrics": [
    {
      "type": "v",
      "text": "Tiada terukur besar\nkasih setia-Mu Tuhan",
      "newGroup": true
    },
    {
      "type": "v",
      "text": "Panjang dan lebarnya\nmelebihi lautan",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Jauh tinggi mengatasi langit\nDalamnya ‘tak dapat kuselami",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Kasih setia-Mu besar,\nselamanya",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Kasih setia-Mu besar,\nselamanya",
      "newGroup": false
    },
    {
      "type": "c",
      "text": "Hatiku bersyukur,\njiwaku memuji",
      "newGroup": true
    },
    {
      "type": "c",
      "text": "Mulutkupun bersorak\nmemuji Engkau, Yesus",
      "newGroup": false
    },
    {
      "type": "c",
      "text": "Ajaib perbuatan-Mu,\nbesar anug’rah-Mu",
      "newGroup": false
    },
    {
      "type": "c",
      "text": "Tak’kan berhenti,\nkumemuji Nama-Mu",
      "newGroup": false
    }
  ]
}