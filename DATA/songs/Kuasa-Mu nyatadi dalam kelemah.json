{
  "title": "Kuasa-Mu nyatadi dalam kelemah",
  "lyrics": [
    {
      "type": "v",
      "text": "Kuasa-Mu nyata\ndi dalam kelemahanku",
      "newGroup": true
    },
    {
      "type": "v",
      "text": "Kekuatan-Mu menopang\nseluruh hidupku",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Dari mana datang\npertolonganku",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Hanya Yesus pertolonganku",
      "newGroup": false
    },
    {
      "type": "c",
      "text": "Engkaulah sumber\nkekuatan hatiku",
      "newGroup": true
    },
    {
      "type": "v",
      "text": "Tempat persembunyianku",
      "newGroup": true
    },
    {
      "type": "v",
      "text": "Engkau penolong\ndi saat susahku",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Tempat perlindunganku",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Kau menara dan\nperisai di hidupku",
      "newGroup": false
    }
  ]
}