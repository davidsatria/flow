{
  "title": "Sungguh Ku Bangga Bapa",
  "lyrics": [
    {
      "type": "v",
      "text": "Sungguh kubangga Bapa\nPunya Allah seperti Engkau",
      "newGroup": true
    },
    {
      "type": "v",
      "text": "Sungguh kubangga Yesus\nAtas segala pengorbanan-Mu",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Tak ingin aku hidup\nLepas dari kasih-Mu",
      "newGroup": true
    },
    {
      "type": "v",
      "text": "Kasih-Mu menyelamatkan\nDan beriku pengharapan",
      "newGroup": false
    },
    {
      "type": "c",
      "text": "Kini kupersembahkan\nApa yang aku miliki",
      "newGroup": true
    },
    {
      "type": "c",
      "text": "Memang tiada berarti\nBila dibanding dengan kasih-Mu",
      "newGroup": false
    },
    {
      "type": "c",
      "text": "Namun ku ingin membri\nDengan sukacita di hati",
      "newGroup": true
    },
    {
      "type": "c",
      "text": "Karena kutahu ini\nMenyenangkan hati-Mu",
      "newGroup": false
    }
  ]
}