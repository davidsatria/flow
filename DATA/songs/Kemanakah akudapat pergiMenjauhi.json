{
  "title": "Kemanakah akudapat pergiMenjauhi",
  "lyrics": [
    {
      "type": "v",
      "text": "Kemanakah aku\ndapat pergi",
      "newGroup": true
    },
    {
      "type": "v",
      "text": "Menjauhi Roh-Mu\nyang suci",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Kau sahabat\ndan Kau dekat",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Bahkan seluruh\npengabdianku",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Tak bisa membalas\nkesetiaan-Mu",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Sungguh mulia\ndan berharga",
      "newGroup": false
    },
    {
      "type": "c",
      "text": "Sungguh besar\npengorbanan-Mu bagiku",
      "newGroup": true
    },
    {
      "type": "v",
      "text": "Terlalu dalam untuk\ndimengerti, sungguh besar",
      "newGroup": true
    },
    {
      "type": "v",
      "text": "Sungguh indah yang\nKau pikirkan tentangku",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Tak terselami bagiku\nSungguh indah",
      "newGroup": false
    }
  ]
}