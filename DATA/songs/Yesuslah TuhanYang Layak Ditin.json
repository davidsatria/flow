{
  "title": "Yesuslah TuhanYang Layak Ditin",
  "lyrics": [
    {
      "type": "v",
      "text": "Yesuslah Tuhan\nYang Layak Ditinggikan",
      "newGroup": true
    },
    {
      "type": "v",
      "text": "Layak Disembah\nOleh Suku-Suku Bangsa",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Dengan Darah-Mu\nKau Telah Tebus Dosaku",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Genapi Tuhan\nFirman-Mu Atas Negeriku",
      "newGroup": false
    },
    {
      "type": "c",
      "text": "Hatiku Rindu\nMelihat Kemuliaan-Mu",
      "newGroup": true
    },
    {
      "type": "v",
      "text": "Hatiku Rindu\nMelihat Curahan Kuasa-Mu",
      "newGroup": true
    },
    {
      "type": "v",
      "text": "Ditanah Tercinta\nNegeriku Indonesia",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Ku Berdoa Indonesia\nPenuh Kemuliaan-Mu",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Indonesia Bagi\nKemuliaan-Mu",
      "newGroup": false
    },
    {
      "type": "c",
      "text": "Ya Allahku Nyatakan\nKemuliaan-Mu",
      "newGroup": true
    },
    {
      "type": "v",
      "text": "Ya Allahku Nyatakan\nCurahan Kuasa-Mu",
      "newGroup": true
    },
    {
      "type": "v",
      "text": "Di Tanah Tercinta\nNegeriku Indonesia",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Ku Berdoa Indonesia\nPenuh Kemuliaan-Mu",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Indonesia Bagi\nKemuliaan-Mu",
      "newGroup": false
    }
  ]
}