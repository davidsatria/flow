    },
    {
      "type": "v",
      "text": "Jangan kau\nk'raskan hatimu\nturutlah printah\nTuhan",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Haruslah lahir\nsemula\ndalam air\ndan Roh",
      "newGroup": false
    }
