{
  "title": "O lihatlahtanda zamandunia mau",
  "lyrics": [
    {
      "type": "v",
      "text": "O lihatlah\ntanda zaman\ndunia mau\nbinasalah",
      "newGroup": true
    },
    {
      "type": "v",
      "text": "Tuhan Yesus\nhampir datang\nbersedialah",
