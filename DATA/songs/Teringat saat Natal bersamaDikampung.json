{
  "title": "Teringat saat Natal bersamaDikampung",
  "lyrics": [
    {
      "type": "v",
      "text": "Teringat saat Natal bersama",
      "newGroup": true
    },
    {
      "type": "v",
      "text": "Dikampung halamanku",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Terkenang wajah mama papa",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Yang aku kasihi",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Bertahun sudah kita tak jumpa",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Hati ini sangat rindu",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Tuhan sertailah mereka",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Kini satu lagi tahun berganti",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Di hari hidup kita ini",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Adakah kita kan bertemu",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Adakah Tuhan…",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Selangkah saja mau menghampiri",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Pada hidup kita ini",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Tuhan sertailah mereka",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Bila kuingat kembali",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Kasih sayangmu",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "yang telah membesarkan daku",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Ingin rasanya ku kembali",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Pada manisnya masa kecilku dulu",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Oh…oh…,",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Mama…,\nSelamat Natal Mama",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Papa…,\nSelamat Natal Papa",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Mama…,",
      "newGroup": false
    }
  ]
