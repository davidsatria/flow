{
  "title": "Engkau ada bersamakuDi s'tiap musim 2",
  "lyrics": [
    {
      "type": "v",
      "text": "Engkau ada bersamaku\nDi s'tiap musim hidupku",
      "newGroup": true
    },
    {
      "type": "v",
      "text": "'Tak pernah\n'Kau biarkan kusendiri",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Kekuatan dijiwaku\nadalah bersama-Mu",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "'Tak pernah kuragukan\nkasih-Mu",
      "newGroup": false
    },
    {
      "type": "c",
      "text": "Bersama-Mu Bapa\nkulewati semua",
      "newGroup": true
    },
    {
      "type": "v",
      "text": "Perkenanan-Mu yang\nteguhkan hatiku",
      "newGroup": true
    },
    {
      "type": "v",
      "text": "Engkau yang bertindak\nmemb'ri pertolongan",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Anug'rah-Mu besar\nmelimpah bagiku",
      "newGroup": false
    }
  ]
}