{
  "title": "Doa Yabes",
  "lyrics": [
    {
      "type": "v",
      "text": "Kiranya Engkau Memberkati Aku\nBerlimpah-Limpah",
      "newGroup": true
    },
    {
      "type": "v",
      "text": "Dan Memperluas\nDaerahku",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Dan Kiranya\nTanganmu Menyertai Aku",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Dan Melindungi Aku\nDari Pada Malapetaka",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Sehingga Kesakitan\nTidak Menimpa Aku",
      "newGroup": false
    },
    {
      "type": "e",
      "text": "Tuhan Mendengarkan\nDan Menjawab Doa Ku",
      "newGroup": true
    }
  ]
}