  "lyrics": [
    {
      "type": "v",
      "text": "Kau memilihku Menjadikanku\nSesuai rencana-Mu",
      "newGroup": true
    },
    {
      "type": "v",
      "text": "Kau menentukan Arah tujuan\nSeturut langkah-Mu",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Bagi yang berjalan\nMelangkah sesuai panggilan-Nya",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Rencana indah dib'rikan Dia\nBagi kita yang percaya",
