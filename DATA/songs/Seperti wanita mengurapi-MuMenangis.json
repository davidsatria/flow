{
  "title": "Seperti wanita mengurapi-MuMenangis",
  "lyrics": [
    {
      "type": "v",
      "text": "Seperti wanita mengurapi-Mu\nMenangis di bawah kaki-Mu",
      "newGroup": true
    },
    {
      "type": "v",
      "text": "Demikian hidupku mau mengasihi-Mu\nYesus Engkau baik bagiku",
      "newGroup": false
    },
    {
      "type": "c",
      "text": "Sampai akhir kumenutup mata\nKu tetap setia menanti janji-Mu",
      "newGroup": true
    },
    {
      "type": "v",
      "text": "Sampai kudapatkan\nmahkota kehidupanku",
      "newGroup": true
    },
    {
      "type": "v",
      "text": "Ku tetap setia kumelayani-Mu",
      "newGroup": false
    }
  ]
}