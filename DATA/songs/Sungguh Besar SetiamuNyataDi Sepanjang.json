      "text": "Kutinggikan Engkau Tuhan\nMelebihi Segalanya",
      "newGroup": true
    },
    {
      "type": "v",
      "text": "Lebih Dalam Kumenyembah\nDalam Roh Dan Keb'naran",
      "newGroup": true
