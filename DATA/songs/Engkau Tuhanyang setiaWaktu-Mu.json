{
  "title": "Engkau Tuhanyang setiaWaktu-Mu",
  "lyrics": [
    {
      "type": "v",
      "text": "Engkau Tuhan\nyang setia",
      "newGroup": true
    },
    {
      "type": "v",
      "text": "Waktu-Mu s'lalu\nyang terbaik",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Engkau Tuhan\nsandaranku",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Dan ku hanya\nkan berharap pada-Mu",
      "newGroup": false
    },
    {
      "type": "c",
      "text": "Satu-satunya yang\nku andalkan",
      "newGroup": true
    },
    {
      "type": "v",
      "text": "Satu-satunya yang\nku percaya",
      "newGroup": true
    },
    {
      "type": "v",
      "text": "Engkau sumber kekuatan\nSumber pengharapan",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "sumber kedamaian",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Satu-satunya yang\nku andalkan",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Satu-satunya yang\nku percaya",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Engkau Tuhan memberkati\nTuhan penyembuhku",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Tuhan pemulihku",
      "newGroup": false
    }
  ]
}