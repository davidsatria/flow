{
  "title": "Sebagai saudara seimanDi dalam",
  "lyrics": [
    {
      "type": "v",
      "text": "Sebagai saudara seiman\nDi dalam Tubuh Kristus",
      "newGroup": true
    },
    {
      "type": "v",
      "text": "Menyerahkan sluruh hidupNya\nBerbagi kasih bersama",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Kadang tawa kadang tangis\nSuka duka bersama",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Yang kuat menanggung yang lemah\nDalam anugrahNya",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Kita bertumbuh\nbertumbuh di dalam kasih",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Sehati sepikir\nsetujuan melangkah bersama",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Tuaian besar tlah\nmenanti di hadapan kita",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Siapkanlah dirimu\nsongsong hari esok",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Dan Tuhan dimuliakan\nmelalui gerejaNya",
      "newGroup": false
    }
  ]
}