{
  "title": "Syukur untuksetiap rencana-MuDan",
  "lyrics": [
    {
      "type": "v",
      "text": "Syukur untuk\nsetiap rencana-Mu",
      "newGroup": true
    },
    {
      "type": "v",
      "text": "Dan rancangan-Mu\nyang mulia",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Dalam satu tubuh\nkami bersatu",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Menjadi duta\nkerajaan-Mu",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Kuucapkan berkat atas\nIndonesia (Malang Raya)",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Biar kemuliaan Tuhan\nakan nyata",
      "newGroup": false
    },
    {
      "type": "c",
      "text": "Bagi bangsa ini (Malang Raya)\nkami berdiri",
      "newGroup": true
    },
    {
      "type": "v",
      "text": "Dan membawa doa\nkami kepada-Mu",
      "newGroup": true
    },
    {
      "type": "v",
      "text": "Sesuatu yang besar\npasti terjadi",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Dan mengubahkan\nnegeri kami",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Hanya nama-Mu\nTuhan ditinggikan",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Atas seluruh bumi",
      "newGroup": false
    }
  ]
}