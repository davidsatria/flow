{
  "title": "Dengan seg'nap hatidan jiwakuKu",
  "lyrics": [
    {
      "type": "v",
      "text": "Dengan seg'nap hati\ndan jiwaku",
      "newGroup": true
    },
    {
      "type": "v",
      "text": "Ku datang pada-Mu\ndalam kerinduan",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Kasih-Mu yang\nsanggup mengubahku",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Dan menguatkanku\ndalam pengharapan",
      "newGroup": false
    },
    {
      "type": "c",
      "text": "Yesus, Engkaulah\npermata hatiku",
      "newGroup": true
    },
    {
      "type": "v",
      "text": "Dunia tak dapat\nmenggantikan-Mu",
      "newGroup": true
    },
    {
      "type": "v",
      "text": "Kemuliaan-Mu\ntercurah bagiku",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Menjadikanku indah dan\nsemakin indah bagi-Mu",
      "newGroup": false
    }
  ]
}