{
  "title": "Inilah rinduku kepada-MuSegenap",
  "lyrics": [
    {
      "type": "v",
      "text": "Inilah rinduku\nkepada-Mu",
      "newGroup": true
    },
    {
      "type": "v",
      "text": "Segenap hatiku\nmenyembah-Mu",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Seluruh jiwaku\nmemuji-Mu",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Kumemuja-Mu\nya Allahku",
      "newGroup": false
    },
    {
      "type": "c",
      "text": "Kuberikan hatiku\ndan jiwaku",
      "newGroup": true
    },
    {
      "type": "c",
      "text": "Semuanya\nbagi-Mu",
      "newGroup": false
    },
    {
      "type": "c",
      "text": "Di dalam hidupku\ndi setiap waktu",
      "newGroup": false
    },
    {
      "type": "c",
      "text": "Nyatakan\njalan-Mu",
      "newGroup": false
    }
  ]
}