  "title": "PreKubahagia kubahagiakubahagiaKu",
  "lyrics": [
    {
      "type": "v",
      "text": "Pre\nKubahagia, kubahagia\nkubahagia",
      "newGroup": true
    },
    {
      "type": "v",
      "text": "Ku berbahagia, yakin teguh\nYesus abadi kepunyaanku",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Aku waris-Nya, ku ditebus,\nciptaan baru Rohul kudus.",
      "newGroup": false
    },
    {
      "type": "c",
      "text": "Aku bernyanyi bahagia\nmemuji Yesus selamanya.",
      "newGroup": true
    },
    {
      "type": "v",
      "text": "memuji Yesus selamanya.",
      "newGroup": true
    },
    {
      "type": "v",
      "text": "Aku serahkan diri penuh,\ndalam Tuhanku hatiku teduh.",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Sambil menyongsong kembali-Nya,\nKu diliputi anugerah.",
      "newGroup": false
    },
    {
      "type": "c",
      "text": "Aku bernyanyi bahagia\nmemuji Yesus selamanya.",
