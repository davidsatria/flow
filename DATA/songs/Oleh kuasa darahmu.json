{
  "title": "Oleh kuasa darahmu",
  "lyrics": [
    {
      "type": "v",
      "text": "Saat ku masuk\nkehadiratMu",
      "newGroup": true
    },
    {
      "type": "v",
      "text": "Bawa persembahan\nketempat kudusMu",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Pujian ku naikan\nsembah ku berikan",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "BagiMu Allah yang Mulia",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Kau layakkan ku\nmenghampiriMu",
      "newGroup": true
    },
    {
      "type": "v",
      "text": "Melihat Tahta\nkemuliaanMu Tuhan",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Pujian ku naikkan\nsembah ku berikan",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "BagiMu Allah yang mulia",
      "newGroup": false
    },
    {
      "type": "c",
      "text": "Oleh kuasa darahMu\nKau telah tebus dosaku",
      "newGroup": true
    },
    {
      "type": "c",
      "text": "KekudusanMu melingkupiku",
      "newGroup": false
    },
    {
      "type": "c",
      "text": "KasihMu mengalir\nmemulihkan hidupku",
      "newGroup": false
    },
    {
      "type": "c",
      "text": "Sungguh besar anugrahMu\nKau selamatkan hidupku",
      "newGroup": false
    },
    {
      "type": "c",
      "text": "Kumenjadi ciptaan yang baru\noleh kuasa darahMu",
      "newGroup": false
    }
  ]
}