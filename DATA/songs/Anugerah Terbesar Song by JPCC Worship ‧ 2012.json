{
  "title": "Anugerah Terbesar Song by JPCC Worship ‧ 2012",
  "lyrics": [
    {
      "type": "v",
      "text": "Kasih-Mu tiada bertepi\nHati-Mu tak terselami",
      "newGroup": true
    },
    {
      "type": "v",
      "text": "Betapa baiknya Engkau\nKu bersyukur pada-Mu",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Perkenanan-Mu ya Tuhan\nNyata didalam hidupku",
      "newGroup": true
    },
    {
      "type": "v",
      "text": "Sungguh Kau yang termulia\nJiwaku pun menyembah",
      "newGroup": false
    },
    {
      "type": "c",
      "text": "Ku angkat hatiku\ntinggikan nama-Mu",
      "newGroup": true
    },
    {
      "type": "c",
      "text": "Karna Yesus\nKau anugerah terbesar",
      "newGroup": false
    },
    {
      "type": "c",
      "text": "Ku naikkan syukurku\n'tuk kemurahan-Mu",
      "newGroup": false
    },
    {
      "type": "c",
      "text": "Hanya Yesus\nKau anugerah terbesar",
      "newGroup": false
    }
  ]
}