  "title": "Kau TuhanYang s'lamatkankuT'rima",
  "lyrics": [
    {
      "type": "v",
      "text": "Kau Tuhan\nYang s'lamatkanku",
      "newGroup": true
    },
    {
      "type": "v",
      "text": "T'rima Kasih Yesus",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Kau Tuhan\nYang Pulihkanku",
