{
  "title": "Kami bawa kurbansaat ini Tuhan",
  "lyrics": [
    {
      "type": "v",
      "text": "Kami bawa kurban\nsaat ini Tuhan",
      "newGroup": true
    },
    {
      "type": "v",
      "text": "Persembahan syukurku bagi-Mu",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Dengan rela hatiku",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "dan penuh sukacita",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Sungguh itulah yang Kau kehendaki",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Kami bawa kurban saat ini Tuhan",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Persembahan syukurku bagi-Mu",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Diiringi nyanyian, diiringi pujian",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Kiranya berkenan\ndi hadapan-Mu",
      "newGroup": false
    },
    {
      "type": "c",
      "text": "Walaupun tak berarti",
      "newGroup": true
    },
    {
      "type": "v",
      "text": "Sangat sedikit sekali",
      "newGroup": true
    },
    {
      "type": "v",
      "text": "Kutaruh\ndi mezbah segenap hati",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Semua yang kuberikan",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "daripada-Mu Tuhan",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Untuk kepentingan pekerjaan-Mu",
      "newGroup": false
    }
  ]
}