{
  "title": "Ku Ada Sebagaimana Ku Ada",
  "lyrics": [
    {
      "type": "v",
      "text": "Ku ada\nsebagaimana ku ada",
      "newGroup": true
    },
    {
      "type": "v",
      "text": "Berdiri menghadap\ntahta-Mu Bapa",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Semua kar'na anug'rah-Mu\nYang t'lah s'lamatkanku",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Ku hidup dalam\ns'gala kelimpahan",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Ku layak untuk\nmelayani Tuhan",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Semua kar'na anug'rah-Mu\nTercurah bagiku",
      "newGroup": false
    },
    {
      "type": "c",
      "text": "Besar anug'rah-Mu\nMelimpah kasih-Mu",
      "newGroup": true
    },
    {
      "type": "c",
      "text": "Semakin hari\ns'makin bertambah",
      "newGroup": false
    },
    {
      "type": "c",
      "text": "Besar anug'rah-Mu",
      "newGroup": false
    }
  ]
}