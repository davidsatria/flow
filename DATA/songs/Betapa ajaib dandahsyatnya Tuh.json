{
  "title": "Betapa ajaib dandahsyatnya Tuh",
  "lyrics": [
    {
      "type": "v",
      "text": "Betapa ajaib dan\ndahsyatnya Tuhan\nkejadianku",
      "newGroup": true
    },
    {
      "type": "v",
      "text": "Kau menenun diriku\nserupa gambaranMu\nO....O....",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Sungguh berharga\ndi mataMu Tuhan\nkehidupanku",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Kau membawa hatiku\nmendekat, erat\ndengan hatiMu",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Kumengangkat wajahku\nmemandang\nkeindahanMu Yesus",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Syukur bagi\nkesetiaanMu\ndisepanjang\nhidupku",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Dan kuangkat tanganku, ketahta\nkasih dan karuniaMu",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Tak sekalipun\nKau tinggalkanku\nYesus sahabatku",
      "newGroup": false
    }
  ]
}