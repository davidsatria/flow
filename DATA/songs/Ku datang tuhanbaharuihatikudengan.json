{
  "title": "Ku datang tuhanbaharuihatikudengan",
  "lyrics": [
    {
      "type": "v",
      "text": "Ku datang tuhan",
      "newGroup": true
    },
    {
      "type": "v",
      "text": "baharui\nhatiku",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "dengan anugrah",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "di dalam engkau",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "ku tahu tuhan\nkelemahan hatiku",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "akan terhapus oleh kuasa kasihmu",
      "newGroup": false
    },
    {
      "type": "c",
      "text": "kasihmu melingkupi hidupku",
      "newGroup": true
    },
    {
      "type": "v",
      "text": "bawaku\ndekat padamu",
      "newGroup": true
    },
    {
      "type": "v",
      "text": "ku kan terbang",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "bagaikan rajawali",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Ending\nrohmu menangkanku",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "terbang\nlebih tinggi",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "oleh kuasa kasihmu",
      "newGroup": false
    }
  ]
}