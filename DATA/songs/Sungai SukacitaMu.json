{
  "title": "Sungai SukacitaMu",
  "lyrics": [
    {
      "type": "v",
      "text": "Sungai SukacitaMu\nmengalir dalamku",
      "newGroup": true
    },
    {
      "type": "v",
      "text": "Anggur sukacitaMu\nmelimpah dalamku",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Ku menari\ndan bersuka",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "PujiMu\ndi setiap waktu",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Sebab sungai sukacitaMu\nAda dalamku",
      "newGroup": false
    },
    {
      "type": "c",
      "text": "Mengalir bersamaMu\nBersuka di dalamMu",
      "newGroup": true
    },
    {
      "type": "c",
      "text": "mengikutiMu Tuhan\nDalam kegerakkanMu",
      "newGroup": false
    },
    {
      "type": "c",
      "text": "MelayaniMu Tuhan\nDi dalam SukacitaMu",
      "newGroup": false
    },
    {
      "type": "c",
      "text": "Sbab hanya Tuhan\nYang membuat sukacitaku penuh",
      "newGroup": false
    }
  ]
}