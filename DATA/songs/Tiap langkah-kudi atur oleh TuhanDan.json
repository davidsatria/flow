{
  "title": "Tiap langkah-kudi atur oleh TuhanDan",
  "lyrics": [
    {
      "type": "v",
      "text": "Tiap langkah-ku\ndi atur oleh Tuhan",
      "newGroup": true
    },
    {
      "type": "v",
      "text": "Dan tangan kasih-Nya\nMenuntunku",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Di tengah gelombang\ndunia menakutkan",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Hatiku tetap\ntenang teguh",
      "newGroup": false
    },
    {
      "type": "c",
      "text": "Tiap langkah-ku tahu\nTuhan yang pimpin",
      "newGroup": true
    },
    {
      "type": "v",
      "text": "Ketempat tinggi\nku di hantarnya",
      "newGroup": true
    },
    {
      "type": "v",
      "text": "Hingga sekali\nnanti aku tiba",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Di rumah Bapa\nSurga yang baka",
      "newGroup": false
    }
  ]
}