      "text": "Ingin kureguk kesejukan\nAir hidupMu Tuhan",
      "newGroup": false
    },
    {
      "type": "c",
      "text": "Penuhi aku sekarang\nPenuhilah hidupku",
      "newGroup": true
    },
    {
      "type": "v",
      "text": "Hanya Engkau yang kurindu\nJamahlah hidupku Tuhan",
      "newGroup": true
