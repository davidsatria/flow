      "text": "kasih setia Allah\npada kita",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Besar kasih Allah\npada kita",
      "newGroup": false
    },
    {
      "type": "c",
      "text": "Ku tak kan lupa kasihNya,\nku tak kan lupa anugrahNya",
      "newGroup": true
    },
    {
      "type": "v",
      "text": "Dia penuhkan, Dia penuhkan,\nDia puaskan hasratku",
      "newGroup": true
    },
    {
      "type": "v",
      "text": "Besar kasih Allah\npada kita",
      "newGroup": false
    }
