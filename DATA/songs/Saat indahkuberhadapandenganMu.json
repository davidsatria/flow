{
  "title": "Saat indahkuberhadapandenganMu",
  "lyrics": [
    {
      "type": "v",
      "text": "Saat indah\nkuberhadapan\ndenganMu",
      "newGroup": true
    },
    {
      "type": "v",
      "text": "Memandang\nwajahMu\nYesus\nkekasih jiwaku",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Bawa daku\nerat dalam\npelukanMu",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Menikamti kasih\ndan indahnya\nhadiratMu",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "HadiratMu Tuhan\nkurasakan\nkekudusanMu Bapa\npenuhiku",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Kurindu selalu\ndiam dalam\nbaitMu",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Menikmati kasih\nanugerahMu",
      "newGroup": false
    }
  ]
}