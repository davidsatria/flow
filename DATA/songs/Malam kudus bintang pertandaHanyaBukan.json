{
  "title": "Malam kudus bintang pertandaHanyaBukan",
  "lyrics": [
    {
      "type": "v",
      "text": "Malam kudus, bintang pertanda",
      "newGroup": true
    },
    {
      "type": "v",
      "text": "Hanya",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Bukan di istana, hanya kandang domba",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Bayi Yesus t’lah lahir, mari sambutlah Dia",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Karna cinta Kau turun ke dunia",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "buktikan kasih kepada manusia yang penuh dosa",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Karna cinta Bapa mengirim anak-Nya",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Hari natal pun telah tiba",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Yang Kau pinta bukanlah harta",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Hati yang sederhana lebih berharga",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Yang kupercaya Engkau beserta",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "B’rikan damai sejaht’ra",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Untuk s’lama-lamanya",
      "newGroup": false
    }
  ]
}