      "type": "v",
      "text": "Urapan allah terjadi\nDi tempat ini",
      "newGroup": true
    },
    {
      "type": "v",
      "text": "Allah hancurkan\nSetiap belengkij dosa",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Sorak kemenangan\nTerdengar di tempat ini",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Di sini ada\nUrapan baru",
      "newGroup": false
    }
  ]
