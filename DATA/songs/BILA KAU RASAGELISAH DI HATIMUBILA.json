{
  "title": "BILA KAU RASAGELISAH DI HATIMUBILA",
  "lyrics": [
    {
      "type": "v",
      "text": "BILA KAU RASA\nGELISAH DI HATIMU",
      "newGroup": true
    },
    {
      "type": "v",
      "text": "BILA KELAM KABUT\nTAK MENENTU DIRIMU",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "INGAT MASIH ADA",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "SEORANG PENOLONG BAGI MU",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "YESUS TAK PERNAH JAUH DARIMU",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "BILA COBAAN MENGGODAI HATIMU",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "BILA SENGSARA MENIMPA KEADAANMU",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "INGAT YESUS TAKKAN PERNAH JAUH DARIMU",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "DIA SELALU PEDULIKAN KAMU",
      "newGroup": false
    },
    {
      "type": "c",
      "text": "BERSERU MEMANGGIL NAMANYA",
      "newGroup": true
    },
    {
      "type": "v",
      "text": "BERDOA DIAKAN SEGERA",
      "newGroup": true
    },
    {
      "type": "v",
      "text": "MENGHAMPIRI DIRIMU",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "PERCAYA DIA TAK JAUH DARIMU",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "DIA HANYA SEJAUH DOA",
      "newGroup": false
    }
  ]
}