{
  "title": "Kami yang t'lah di tebusDengan",
  "lyrics": [
    {
      "type": "v",
      "text": "Kami yang t'lah di tebus\nDengan darah yang kudus",
      "newGroup": true
    },
    {
      "type": "v",
      "text": "Mengangkat pujian bagiMu\nKami bait kudus-MU",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "S'bagai bukti karya-Mu",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Nyatakan Kau\nbesar dan hidup",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Berlari sampai tujuan\nMendapatkan mahkota\nkekal",
      "newGroup": false
    },
    {
      "type": "c",
      "text": "Kami t'rima\nkuasa-Mu Tuhan",
      "newGroup": true
    },
    {
      "type": "v",
      "text": "Kami t'rima kemenangan\nyang Engkau sediakan",
      "newGroup": true
    },
    {
      "type": "v",
      "text": "'Tuk kami\nbawa di setiap langkah",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Dimanapun\nkami berdiri",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Kemanapun\nkami 'kan pergi",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Disitu pasti\nmujizat-Mu terjadi",
      "newGroup": false
    }
  ]
}