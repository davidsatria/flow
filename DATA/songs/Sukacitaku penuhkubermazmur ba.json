    {
      "type": "v",
      "text": "Oleh curahan\nDarahMu",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Kumenari bagiMu\nkumemuji namaMu",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "kar'na kutahu\nkuberk'menangan",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Oleh curahan\nDarahMu",
      "newGroup": false
    },
    {
      "type": "c",
      "text": "DarahMu Yesus sucikan daku\nDarahMu Yesus bebaskanku",
      "newGroup": true
    },
    {
      "type": "v",
