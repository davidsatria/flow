{
  "title": "Lebih dariBapa di duniaKAU men",
  "lyrics": [
    {
      "type": "v",
      "text": "Lebih dari\nBapa di dunia",
      "newGroup": true
    },
    {
      "type": "v",
      "text": "KAU menjaga\nhidupku ya Allah",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Bahkan lebih dari\nkasih seorang ibu",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Engkau selalu\nmenyambutku.",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Lebih dari yang\ndunia tawarkan",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "kau b'rikan\nyang terbaik oh TUHAN.",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Sekalipun tak\nseorang mengindahkanku",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "ENGKAU tak\npernah membuangku.",
      "newGroup": false
    },
    {
      "type": "c",
      "text": "KAU mengasihiku\nlebih dari yang kuduga.",
      "newGroup": true
    },
    {
      "type": "v",
      "text": "Bahkan di saatku\ntiada menyadarinya.",
      "newGroup": true
    },
    {
      "type": "v",
      "text": "Kau sentuh hatiku\ndengan kasih yang sempurna.",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Kau menyayangiku\nlebih dari yang kurasa.",
      "newGroup": false
