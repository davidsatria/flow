{
  "title": "Salib-Mumembuka matakuBetapa b",
  "lyrics": [
    {
      "type": "v",
      "text": "Salib-Mu\nmembuka mataku",
      "newGroup": true
    },
    {
      "type": "v",
      "text": "Betapa berharga\nNilai hidupku",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Menanggung\nsemua dosaku",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Berikan hidup-Mu\nMenggantikan diriku",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Bukan kar'na\nperbuatanku",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Anug'rah yang selamatkanku",
      "newGroup": false
    },
    {
      "type": "c",
      "text": "Yesus\napa arti hidupku",
      "newGroup": true
    },
    {
      "type": "v",
      "text": "Bila Kau tak berikan\nnyawa-Mu?",
      "newGroup": true
    },
    {
      "type": "v",
      "text": "Yang terbaik\nTersedia bagiku",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Ku bersyukur\natas kasih karunia-Mu",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Yesus\nKaulah arti hidupku",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Yang telah memberikan nyawa-Mu",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Yang terbaik\nTersedia bagiku",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Ku bersyukur\natas kasih karunia-Mu",
      "newGroup": false
