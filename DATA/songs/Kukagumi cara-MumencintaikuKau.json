{
  "title": "Kukagumi cara-MumencintaikuKau",
  "lyrics": [
    {
      "type": "v",
      "text": "Kukagumi cara-Mu\nmencintaiku",
      "newGroup": true
    },
    {
      "type": "v",
      "text": "Kau ada di cerita\nproses hidupku",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Di titik terendahku, Kau\nhadir tuk mengangkatku",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Ku tahu Kau tak menyerah\nakan hidupku",
      "newGroup": false
    },
    {
      "type": "c",
      "text": "Tak terbatas kuasa-Mu\nTak Terduga cara-Mu",
      "newGroup": true
    },
    {
      "type": "v",
      "text": "Kau yang kuandalkan\nDisetiap langkah hidupku",
      "newGroup": true
    },
    {
      "type": "v",
      "text": "Tak terbatas Kasih-Mu\nTak terduga jalan-Mu",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Kau yang kupercaya\nDi s'gala musim hidupku",
      "newGroup": false
    },
    {
      "type": "b",
      "text": "Cara-Mu mengangkatku\nCara-Mu mengubah hatiku",
      "newGroup": true
    },
    {
      "type": "v",
      "text": "Cara-Mu menuntunku",
      "newGroup": true
    },
    {
      "type": "v",
      "text": "Tak terbatas didalam hidupku",
      "newGroup": false
    }
  ]
}