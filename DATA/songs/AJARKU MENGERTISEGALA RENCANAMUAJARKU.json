{
  "title": "Ajarku mengertisegala rencanamuajarku",
  "lyrics": [
    {
      "type": "v",
      "text": "Ajarku mengerti\nSegala rencanamu",
      "newGroup": true
    },
    {
      "type": "v",
      "text": "Ajarku berserah hanya padamu",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Pimpinlah jalanku\nDalam terang firmanmu",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Ajarku berharap\nHanya padamu",
      "newGroup": false
    },
    {
      "type": "c",
      "text": "Bapaku ajaib\nS'gala rancanganmu",
      "newGroup": true
    },
    {
      "type": "c",
      "text": "Tuhanku\nHeran perbuatanmu",
      "newGroup": false
    },
    {
      "type": "c",
      "text": "Engkau sanggup mengadakan\nSegala yang kuperlukan",
      "newGroup": false
    },
    {
      "type": "c",
      "text": "Menurut kehendakmu\nTerjadilah",
      "newGroup": false
    }
  ]
}
