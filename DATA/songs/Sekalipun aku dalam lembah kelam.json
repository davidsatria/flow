      "text": "kutak gentar\ns'bab Kau disisiku",
      "newGroup": false
    },
    {
      "type": "c",
      "text": "Aku percaya\nberkatMu atasku melimpah",
      "newGroup": true
    },
    {
      "type": "c",
      "text": "Kebajikan kemurahan\ns'lalu melingkupiku",
      "newGroup": false
    },
    {
      "type": "c",
      "text": "kupuji kusembah\nKau Tuhan",
      "newGroup": false
