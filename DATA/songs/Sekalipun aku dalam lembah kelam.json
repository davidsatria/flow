      "type": "v",
      "text": "Sekalipun aku\ndalam lembah kelam",
      "newGroup": true
    },
    {
      "type": "v",
      "text": "ku tak takut\ns'bab Kau besertaku",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Sekalipun badai\ntopan datang menerpa",
      "newGroup": false
    },
