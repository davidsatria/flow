    {
      "type": "v",
      "text": "Yesus Domba Allah\nmulia nama-Mu",
      "newGroup": true
    },
    {
      "type": "v",
      "text": "Kau hapus s'gala dosaku\nS'gala cela dan maluku",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Engkaulah segalanya\nSaat jatuh Kau angkatku",
