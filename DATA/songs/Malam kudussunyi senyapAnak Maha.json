{
  "title": "Malam kudussunyi senyapAnak Maha",
  "lyrics": [
    {
      "type": "v",
      "text": "Malam kudus\nsunyi senyap\nAnak Maha Kudus",
      "newGroup": true
    },
    {
      "type": "v",
      "text": "Yang klak\nbawa kami\npadaHu",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Di kandang\nBethlehem\njadiMu",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Tuhan langit\ndan dunia\n(2X)",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Anak kasihan\nAnak Kudus\nyang cinta\nkami trus",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Bagiku\nhilanglah\nhormatMu",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Amat hina\ntempat tidurMu",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Ajarlah\nkubri syukur\n(2X)",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Malam diam\nmalam Kudus\ndamai tlah\ndatang trus",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Didunia\nyang hilang\ndalam glap",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Perjanjian Allah\nsudah gnap",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Amin pujilah\nAllah\n(2X)",
      "newGroup": false
    }
  ]
}