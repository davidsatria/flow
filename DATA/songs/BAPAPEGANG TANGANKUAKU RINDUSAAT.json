{
  "title": "BAPAPEGANG TANGANKUAKU RINDUSAAT",
  "lyrics": [
    {
      "type": "v",
      "text": "BAPA,\nPEGANG TANGANKU",
      "newGroup": true
    },
    {
      "type": "v",
      "text": "AKU RINDU\nSAAT TEDUH BERSAMA-MU",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "DEKAP AKU\nDALAM HANGAT NAUNGAN-MU",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "BAWA HIDUPKU\nPADA-MU,",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "MASUK DALAM\nALTAR-MU YANG KUDUS",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "BAPA,\nPEGANG TANGANKU",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "AKU RINDU\nTINGGAL DI DALAM HATI-MU",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "ENGKAU TERANG\nYANG MEMBUATKU MELIHAT",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "MELIHAT JAUH KE DALAM\nKEBENARAN-MU BAPA",
      "newGroup": false
    },
    {
      "type": "c",
      "text": "LEBIH DARI\nNAFASKU BAPA",
      "newGroup": true
    },
    {
      "type": "v",
      "text": "KUPERLUKAN\nKASIH-MU BAPA",
      "newGroup": true
    },
    {
      "type": "v",
      "text": "BERJALAN\nDI SAMPING-MU BAPA\nSEUMUR HIDUPKU",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "LEBIH DARI\nNAFASKU BAPA",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "KUPERLUKAN\nKASIH-MU BAPA",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "PEGANGLAH\nTANGANKU YA BAPA\nUNTUK SELAMANYA",
      "newGroup": false
    }
  ]
}