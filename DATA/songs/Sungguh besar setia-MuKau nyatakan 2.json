    {
      "type": "b",
      "text": "Tak akan kutakut,\ntak akan kugentar",
      "newGroup": true
    },
    {
      "type": "v",
      "text": "Kaulah imanku\nKaulah Tuhanku",
      "newGroup": true
    },
    {
