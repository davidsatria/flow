{
  "title": "Tak pernah TuhanJanji hidupku tak",
  "lyrics": [
    {
      "type": "v",
      "text": "Tak pernah Tuhan\nJanji hidupku tak 'kan berduri.",
      "newGroup": true
    },
    {
      "type": "v",
      "text": "Tak pernah Dia janji\nlautan tenang",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Tetapi Dia berjanji\n'kan selalu sertaku",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Dan menuntun\njalan hidupku slalu",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Janjinya Dia atur\nlangkahku",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Janjinya Dia\npegang tanganku",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Ku bersyukur Tuhan\ns'lalu p'liharaku",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Ku tahu satu kali\nawan gelapkan berlalu",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Sang Surya bersinar\ndengan megah",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Dan bulan dan bintang\nmenampakkan wajahnya",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Haleluya,\nTuhan puaskan jiwaku",
      "newGroup": false
    }
  ]
}