{
  "title": "Nama-Nya Tuhankumenara yang teguhKota",
  "lyrics": [
    {
      "type": "v",
      "text": "Nama-Nya Tuhanku\nmenara yang teguh",
      "newGroup": true
    },
    {
      "type": "v",
      "text": "Kota benteng\nperlindunganku",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Allah yang perkasa\nDia Bapa yang kekal",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Gunung batu\nkes’lamatanku",
      "newGroup": false
    },
    {
      "type": "c",
      "text": "Engkau yang termulia\ndi bumi di surga",
      "newGroup": true
    },
    {
      "type": "v",
      "text": "Termahsyur perkasa\nselamanya",
      "newGroup": true
    },
    {
      "type": "v",
      "text": "Engkau yang berkuasa\ndi dalam s’gala hal",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Ada kuasa\ndalam nama Yesusku",
      "newGroup": false
    }
  ]
}