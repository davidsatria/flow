{
  "title": "Bukan dengan kekuatankuKu dapat",
  "lyrics": [
    {
      "type": "v",
      "text": "Bukan dengan kekuatanku\nKu dapat jalani hidupku",
      "newGroup": true
    },
    {
      "type": "v",
      "text": "Tanpa Tuhan\nyang disampingku",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Ku tak\nmampu sendiri",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Engkaulah kuatku\nyang menopangku",
      "newGroup": false
    },
    {
      "type": "c",
      "text": "Ku pandang wajah-Mu\ndan berseru",
      "newGroup": true
    },
    {
      "type": "c",
      "text": "Pertolonganku\nDatang dari-Mu",
      "newGroup": false
    },
    {
      "type": "c",
      "text": "Peganglah tanganku\nJangan lepaskan",
      "newGroup": false
    },
    {
      "type": "c",
      "text": "Kaulah harapan\nDalam hidupku",
      "newGroup": false
    }
  ]
}