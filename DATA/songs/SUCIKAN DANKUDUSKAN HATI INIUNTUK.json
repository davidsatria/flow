{
  "title": "Sucikan dankuduskan hati iniuntuk",
  "lyrics": [
    {
      "type": "v",
      "text": "Sucikan dan\nKuduskan hati ini",
      "newGroup": true
    },
    {
      "type": "v",
      "text": "Untuk layak\nMenghadap hadiratmu",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Tubuh jiwa roh-ku\nKu srahkan padamu",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Ku menyembahmu",
      "newGroup": false
    },
    {
      "type": "c",
      "text": "Tinggikan namamu ya tuhan\nMulialah namamu ya tuhan",
      "newGroup": true
    },
    {
      "type": "c",
      "text": "Tiada lain seperti engkau\nYa allahku",
      "newGroup": false
    },
    {
      "type": "c",
      "text": "Besar kuasamu",
      "newGroup": false
    }
  ]
}
