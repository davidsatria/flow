    },
    {
      "type": "v",
      "text": "Dia b'ri damai\ndan kesempatan baru",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Di s'tiap musim kehidupan\nWaktu ku kuat maupun lemah",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Tetap Yesus yang\nmempesona hatiku",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Dia b'ri hidup\ndan kesempatan baru",
