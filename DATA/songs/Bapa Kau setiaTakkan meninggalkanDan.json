{
  "title": "Bapa Kau setiaTakkan meninggalkanDan",
  "lyrics": [
    {
      "type": "v",
      "text": "Bapa Kau setia\nTakkan meninggalkan",
      "newGroup": true
    },
    {
      "type": "v",
      "text": "Dan kupercaya\nEngkau milikku\ndan kumilik-Mu",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Kerinduanku\nTinggikan nama-Mu",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Kar'na ku tahu\nEngkau dalamku\ndan ku dalam-Mu",
      "newGroup": false
    },
    {
      "type": "c",
      "text": "Ubah hatiku\nSeputih hati-Mu",
      "newGroup": true
    },
    {
      "type": "v",
      "text": "Setulus salib-Mu\nKasih-Mu Tuhan",
      "newGroup": true
    },
    {
      "type": "v",
      "text": "Biar mataku\nSeperti mata-Mu",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Pancarkan kasih-Mu\nKumau jadi seperti-Mu",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Oh oh Yesus (seperti-Mu)",
      "newGroup": false
    }
  ]
}