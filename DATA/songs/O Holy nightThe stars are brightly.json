{
  "title": "O Holy nightThe stars are brightly",
  "lyrics": [
    {
      "type": "v",
      "text": "O Holy night!\nThe stars are brightly shining",
      "newGroup": true
    },
    {
      "type": "v",
      "text": "It is the night\nof our dear Savior's birth",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Long lay the world\nin sin and error pining",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "'Til He appears\nand the soul felt its worth",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "A thrill of hope\nthe weary world rejoices",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "For yonder breaks\na new and glorious morn",
      "newGroup": false
    },
    {
      "type": "c",
      "text": "Fall on your knees\nO hear the Angel voices!",
      "newGroup": true
    },
    {
      "type": "v",
      "text": "O night divine\nO night when Christ was born",
      "newGroup": true
    },
    {
      "type": "v",
      "text": "O night, O Holy night\nO night divine!",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Malam kudus\nDi langit bertaburan",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Bintang gemilau terang gemerlap",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Terpencar kini sinar pengharapan\nYang dinantikan sekarang genap",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Dan bangsa yang lelah beroleh harap\nMelihat fajar kini merekah",
      "newGroup": false
    },
    {
      "type": "c",
      "text": "Mari sujud\nDengar kidung malaikat",
      "newGroup": true
    },
    {
      "type": "v",
      "text": "Malam mulia\nMalam Kristus lahir",
      "newGroup": true
    },
    {
      "type": "v",
      "text": "Malam mulia\nMalam malam mulia",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Malam kudus\nDilangit bertaburan",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Bintang gemilau terang cemerlang",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Malam kudus\nDatangnya kebenaran",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Janji ilahi sekarang genap\nDan kini dunia dalam kegelapan",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Menyambut dia juruselamatNya",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Mari sembah\nDengar kidung malaikat",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Malam kudus\nMalam yang cemerlang",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Malam kudus\nMalam lahir yesus",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Malam kudus\nMalam lahir yesus",
      "newGroup": false
    }
  ]
}