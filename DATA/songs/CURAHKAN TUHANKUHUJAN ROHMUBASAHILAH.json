{
  "title": "Curahkan tuhankuhujan rohmubasahilah",
  "lyrics": [
    {
      "type": "v",
      "text": "Curahkan tuhanku\nHujan rohmu",
      "newGroup": true
    },
    {
      "type": "v",
      "text": "Basahilah skarang\nTanah gersang",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Tlah lama kunanti\nBrikan kini",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Lalu kubersujud\nMenyembahmu",
      "newGroup": false
    }
  ]
}
