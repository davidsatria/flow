{
  "title": "Hatiku senanghatiku girangKarena",
  "lyrics": [
    {
      "type": "v",
      "text": "Hatiku senang\nhatiku girang",
      "newGroup": true
    },
    {
      "type": "v",
      "text": "Karena hadirat Tuhan\nada disini",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Apapun masalah\nyang Engkau hadapi",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Akan terlepas\ndalam hadiratNya",
      "newGroup": false
    },
    {
      "type": "c",
      "text": "Mari puji dan\nsembah Tuhan",
      "newGroup": true
    },
    {
      "type": "v",
      "text": "Bebaskan roh untuk\nmenyembah Dia",
      "newGroup": true
    },
    {
      "type": "v",
      "text": "MujizatNya besar terjadi",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Aku bebas aku sembuh\naku menang",
      "newGroup": false
    }
  ]
}