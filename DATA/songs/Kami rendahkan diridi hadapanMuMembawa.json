{
  "title": "Kami rendahkan diridi hadapanMuMembawa",
  "lyrics": [
    {
      "type": "v",
      "text": "Kami rendahkan diri\ndi hadapanMu",
      "newGroup": true
    },
    {
      "type": "v",
      "text": "Membawa hancur hati\nsaat berseru",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Agar kami saling\nmelengkapi tubuhMu",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Seperti Kau dan Yesus\nadalah satu",
      "newGroup": false
    },
    {
      "type": "c",
      "text": "Jadikan kami satu\ns'perti kerinduanMu",
      "newGroup": true
    },
    {
      "type": "v",
      "text": "Agar dunia tahu\nbukti nyata dari kasihMu",
      "newGroup": true
    },
    {
      "type": "v",
      "text": "Sebelum kami pergi\nmemb'ritakan kasihMu",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Mulailah dari kami lebih dulu\njadikan kami satu",
      "newGroup": false
    }
  ]
}