{
  "title": "Allahku kanmemenuhi keperluankuMenurut",
  "lyrics": [
    {
      "type": "v",
      "text": "Allahku kan memenuhi\nkeperluanku",
      "newGroup": true
    },
    {
      "type": "v",
      "text": "Menurut kekayaan\ndan kemuliaannya",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Allahku kan mencukupi kebutuhanku\nDi dalam Yesus Tuhan",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Tiada yang mustahil bagi Dia\nAjaib s'gala perbuatannya",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "S'gala perkara\nkutanggung dalam Dia",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Di dalam kekuatan kuasanya\nDi dalam kekuatan kuasanya",
      "newGroup": false
    }
  ]
