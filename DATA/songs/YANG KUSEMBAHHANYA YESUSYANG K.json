{
  "title": "Yang kusembahhanya yesusyang k",
  "lyrics": [
    {
      "type": "v",
      "text": "Yang kusembah\nHanya yesus",
      "newGroup": true
    },
    {
      "type": "v",
      "text": "Yang kupuja\nHanya yesus",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Yang kusanjung hanya yesus\nSebab kau allahku",
      "newGroup": false
    },
    {
      "type": "c",
      "text": "Yesus,\nKau allahku",
      "newGroup": true
    },
    {
      "type": "v",
      "text": "Yesus,\nEngkau tuhanku",
      "newGroup": true
    },
    {
      "type": "v",
      "text": "Yesus,\nEngkau rajaku",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Yang turun ke dunia",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Yesus\nKusembah kau",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Curahkan\nRoh kudus-mu",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Kini aku menyembah",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Masuk hadirat-mu",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Yang b’ri damai\nHanya yesus",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Yang b’ri berkat\nHanya yesus",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Yang b’ri roh-nya\nHanya yesus",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Sebab kau allahku",
      "newGroup": false
    }
  ]
}
