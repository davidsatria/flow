{
  "title": "Lebih tinggi dari gunungLebih dalam",
  "lyrics": [
    {
      "type": "v",
      "text": "Lebih tinggi dari gunung\nLebih dalam dari lautan",
      "newGroup": true
    },
    {
      "type": "v",
      "text": "Lebih luas dari samudra\nItulah kasih Tuhanku",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Karuniai aku akan kasih-Mu\nYang dunia tiada miliki",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Anug'rah-Mu ubah hidupku\nSeturut dengan kasih-Mu",
      "newGroup": false
    },
    {
      "type": "c",
      "text": "Hangatkanlah hati kami,\nya Tuhan",
      "newGroup": true
    },
    {
      "type": "v",
      "text": "Dengan kasih-Mu\nyang tulus dan suci",
      "newGroup": true
    },
    {
      "type": "v",
      "text": "Untuk mengabdi\nkepada panggilan-Mu",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Di dalam kehidupan\ndunia ini",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Kasih-Mu adalah\ns'gala-galanya",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Kasih-Mu\njawabannya",
      "newGroup": false
    }
  ]
}