      "text": "biarlah hidupku selalu\nmenyenangkan hatiMu",
      "newGroup": false
    },
    {
      "type": "c",
      "text": "betapa kagum kumelihat\nperbuatan tanganMu",
      "newGroup": true
    },
    {
      "type": "c",
      "text": "ajaib dan mulianya kuasaMu\nnyata dalam hidupku",
      "newGroup": false
    },
    {
      "type": "c",
      "text": "sungguh ku tak dapat mengerti\nbesarnya karyaMu",
      "newGroup": false
    },
    {
      "type": "c",
      "text": "oh indahnya oh heran\nkasihMu",
      "newGroup": false
