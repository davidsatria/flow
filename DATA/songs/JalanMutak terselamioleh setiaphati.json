{
  "title": "JalanMutak terselamioleh setiaphati",
  "lyrics": [
    {
      "type": "v",
      "text": "JalanMu tak terselami\noleh setiap hati kami",
      "newGroup": true
    },
    {
      "type": "v",
      "text": "Namun satu hal kupercaya\nada rencana yang indah",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Tiada terduga kasihMu\nheran dan besar bagiku",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Arti kehadiranMu slalu\nnyata di dalam hidupku",
      "newGroup": false
    },
    {
      "type": "c",
      "text": "PenyertaanMu sempurna\nrancanganMu penuh damai",
      "newGroup": true
    },
    {
      "type": "c",
      "text": "Aman dan sejahtera\nwalau ditengah badai",
      "newGroup": false
    },
    {
      "type": "c",
      "text": "Ingin ku s'lalu bersama\nrasakan keindahan",
      "newGroup": false
    },
    {
      "type": "c",
      "text": "Arti kehadiranMu\nTuhan",
      "newGroup": false
    }
  ]
}