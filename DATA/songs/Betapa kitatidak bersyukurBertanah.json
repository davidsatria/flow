{
  "title": "Betapa kitatidak bersyukurBertanah",
  "lyrics": [
    {
      "type": "v",
      "text": "Betapa kita\ntidak bersyukur",
      "newGroup": true
    },
    {
      "type": "v",
      "text": "Bertanah air\nkaya dan subur",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Lautnya luas\ngunungnya megah",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Menghijau padang\nbukit dan lembah",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Itu semua\nBerkat karunia",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Allah yang Agung\nMahakuasa",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Itu semua\nBerkat karunia",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Allah yang Agung\nMahakuasa",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Alangkah indah\npagi merekah",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Bermandi cahya\nsurya nan cerah",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Ditingkah kicau\nburung tak henti",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Bunga pun\nbangkit harum berseri",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Itu semua\nBerkat karunia",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Allah yang\nAgung Mahakuasa",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Itu semua\nBerkat karunia",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Allah yang\nAgung Mahakuasa",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Tanah air ku\ntidak kulupakan",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Kan terkenang\nselama hidupku",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Biarpun saya\npergi jauh",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Tidak kan\nhilang dari kalbu",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Tanah ku yang kucintai\nEngkau kuhargai",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Walaupun banyak\nnegeri kujalani",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Yang masyhur\npermai dikata orang",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Tetapi kampung\ndan rumahku",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Di sanalah\nku rasa senang",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Tanah ku tak kulupakan\nEngkau kubanggakan",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Tanah ku yang kucintai\nEngkau kuhargai",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Bagi bangsa\nini kami berdiri",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Dan membawa doa\nkami kepada-Mu",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Sesuatu yang besar\npasti terjadi",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Dan mengubahkan\nnegeri kami",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Hanya nama-Mu\nTuhan ditinggikan",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Atas seluruh bumi",
      "newGroup": false
    }
  ]
}