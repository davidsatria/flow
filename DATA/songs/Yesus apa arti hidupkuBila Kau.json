{
  "title": "Yesus apa arti hidupkuBila Kau",
  "lyrics": [
    {
      "type": "c",
      "text": "Yesus apa arti hidupku\nBila Kau tak berikan nyawa-Mu",
      "newGroup": true
    },
    {
      "type": "v",
      "text": "Yang terbaik\ntersedia bagiku",
      "newGroup": true
    },
    {
      "type": "v",
      "text": "Ku bersyukur\natas kasih karunia-Mu",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Salib-Mu membuka mataku\nBetapa berharga nilai hidupku",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Menanggung\nsemua dosaku",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Berikan hidup-Mu\nmenggantikan diriku",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Bukan kar’na perbuatanku\nAnug’rah yang selamatkanku",
      "newGroup": false
    },
    {
      "type": "c",
      "text": "Yesus Kaulah\narti hidupku",
      "newGroup": true
    },
    {
      "type": "v",
      "text": "Yang telah\nmemberikan nyawa-Mu",
      "newGroup": true
    },
    {
      "type": "v",
      "text": "Yang terbaik\ntersedia bagiku",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Ku bersyukur\natas kasih karunia-Mu",
      "newGroup": false
