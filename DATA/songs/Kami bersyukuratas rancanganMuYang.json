{
  "title": "Kami bersyukuratas rancanganMuYang",
  "lyrics": [
    {
      "type": "v",
      "text": "Kami bersyukur\natas rancanganMu",
      "newGroup": true
    },
    {
      "type": "v",
      "text": "Yang terbaik\ndan terindah bagi kami",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Kau memberkati\nkehidupan kami",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Melimpah dengan\nkasih dan anugrah",
      "newGroup": false
    },
    {
      "type": "c",
      "text": "Kami dan seisi rumah\nkami bersehati",
      "newGroup": true
    },
    {
      "type": "v",
      "text": "Tuk terus memuji\nmenyembahMu Yesus Tuhan",
      "newGroup": true
    },
    {
      "type": "v",
      "text": "Hingga akhir bahkan\nsampai keturunan kami",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Hidup kami\nmilikMu ya Tuhan",
      "newGroup": false
    }
  ]
}