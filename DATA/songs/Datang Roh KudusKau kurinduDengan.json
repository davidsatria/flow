{
  "title": "Datang Roh KudusKau kurinduDengan",
  "lyrics": [
    {
      "type": "v",
      "text": "Datang Roh Kudus\nKau kurindu",
      "newGroup": true
    },
    {
      "type": "v",
      "text": "Dengan Minyak\nyang Baru urapiku",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Mengalir penuhiku\nmengalir pulihkanku",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Kuasa-Mu bebaskan\nhidupku",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Satu yang kurindu\nbersekutu dengan-Mu",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Bawaku lebih lagi\ntinggal didalam-Mu",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Nikmati hadirat-Mu\njamahlah  s'luruh Hidupku",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Urapan-Mu\nmengubah hidupku",
      "newGroup": false
    }
  ]
}