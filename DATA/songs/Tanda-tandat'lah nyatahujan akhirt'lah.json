{
  "title": "Tanda-tandat'lah nyatahujan akhirt'lah",
  "lyrics": [
    {
      "type": "v",
      "text": "Tanda-tanda\nt'lah nyata\nhujan akhir\nt'lah tiba",
      "newGroup": true
    },
    {
      "type": "v",
      "text": "Allah sedang\nmelawat umatNya",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Ladang telah\nmenguning\nsiap untuk dituai",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Banyak jiwa\nmenanti\nuluran tangan\nkita",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Tuailah-tuailah\nsekarang",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Nyatakan\nkemuliaanNya\npada segala bangsa\nbiar kuasaNya\ndinyatakan melimpah",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Bangkitlah\ngereja Tuhan\npandang\nsekelilingMu",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Generasi ini\ns'lamatkan\nya Tuhan\nini doaku",
      "newGroup": false
    }
  ]
}