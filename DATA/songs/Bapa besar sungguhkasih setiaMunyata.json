{
  "title": "Bapa besar sungguhkasih setiaMunyata",
  "lyrics": [
    {
      "type": "v",
      "text": "Bapa besar sungguh\nkasih setiaMu",
      "newGroup": true
    },
    {
      "type": "v",
      "text": "nyata sungguh\nperlindunganMu",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Tak satu kuasa\nmampu pisahkan",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "aku dari kasihMu",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Bapa ajarku slalu\nhormatiMu",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "ajarku turut\nperintahMu",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Brikanku hati\ntuk menyembahMu",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "dan bersyukur\nstiap waktu",
      "newGroup": false
    },
    {
      "type": "c",
      "text": "Sperti Bapa\nsayang anakNya",
      "newGroup": true
    },
    {
      "type": "c",
      "text": "demikianlah\nEngkau mengasihiku",
      "newGroup": false
    },
    {
      "type": "c",
      "text": "Kau jadikan\nbiji mataMu",
      "newGroup": false
    },
    {
      "type": "c",
      "text": "Kau berikan smua\nyang ada padaMu",
      "newGroup": false
    },
    {
      "type": "c",
      "text": "Sperti Bapa\nsayang anakNya",
      "newGroup": false
    },
    {
      "type": "c",
      "text": "demikianlah Kau\nmenuntun langkahku",
      "newGroup": false
    },
    {
      "type": "c",
      "text": "Hari depan\nindah Kau beri",
      "newGroup": false
    },
    {
      "type": "c",
      "text": "rancanganMu\nyang terbaik bagiku",
      "newGroup": false
    }
  ]
}