{
  "title": "Yesusku Penyelamatku (Medley: Nyanyi dan Bersoraklah)",
  "lyrics": [
    {
      "type": "v",
      "text": "Yesusku, Penyelamatku,\nTiada Yang Seperti Engkau",
      "newGroup": true
    },
    {
      "type": "v",
      "text": "Setiap Hari Kumemuji\nKeajaiban Kasih-Mu",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Penghibur, Pelindung\nMenara Kekuatan",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Biarlah Semua\nYang Bernafas",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Tak Berhenti\nMenyembah-Mu",
      "newGroup": false
    },
    {
      "type": "c",
      "text": "Nyanyi Dan\nBersoraklah Bagi Dia",
      "newGroup": true
    },
    {
      "type": "c",
      "text": "Pujian Hormat,\nKuasa Bagi Raja",
      "newGroup": false
    },
    {
      "type": "c",
      "text": "Gunung Tunduk,\nLaut Bergelora",
      "newGroup": false
    },
    {
      "type": "c",
      "text": "Mendengar Nama-Mu",
      "newGroup": false
    },
    {
      "type": "c",
      "text": "Kubersuka Atas\nPerbuatan-Mu",
      "newGroup": false
    },
    {
      "type": "c",
      "text": "Selamanya Kukasihi\nEngkau Tuhan",
      "newGroup": false
    },
    {
      "type": "c",
      "text": "Tiada Janji Seperti\nYang Ada Pada-Mu",
      "newGroup": false
    }
  ]
}