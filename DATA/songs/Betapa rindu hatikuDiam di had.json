{
  "title": "Betapa rindu hatikuDiam di had",
  "lyrics": [
    {
      "type": "v",
      "text": "Betapa rindu hatiku\nDiam di hadiratMu",
      "newGroup": true
    },
    {
      "type": "v",
      "text": "Memandang wajah yg Mulia\ndalam kekudusanMu",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Kau tebus seg'nap dosaku\nDengan darah yang mulia",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Dan sekarang ku layak\nmenghampiri Mu",
      "newGroup": false
    },
    {
      "type": "c",
      "text": "Ku angkat hatiku\nmenyembah kau Tuhan",
      "newGroup": true
    },
    {
      "type": "c",
      "text": "Ingin kurasakan\njamahanmu Tuhan",
      "newGroup": false
    },
    {
      "type": "c",
      "text": "Curahkan urapan\nRoh Kudus-mu Tuhan",
      "newGroup": false
    },
    {
      "type": "c",
      "text": "Biar hidupku penuh\nmelimpah kuasa-Mu",
      "newGroup": false
    }
  ]
}