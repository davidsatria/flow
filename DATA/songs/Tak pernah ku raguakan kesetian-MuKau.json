{
  "title": "Tak pernah ku raguakan kesetian-MuKau",
  "lyrics": [
    {
      "type": "v",
      "text": "Tak pernah ku ragu\nakan kesetian-Mu",
      "newGroup": true
    },
    {
      "type": "v",
      "text": "Kau pegang hidupku",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Sepenuh jiwaku\nku yakin dan percaya",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Kau tuntun langkahku",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Yesus Kaulah\nRaja dalam hidupku",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Berkuasa berjaya\nuntuk s'lamanya",
      "newGroup": false
    },
    {
      "type": "c",
      "text": "Hanya Kau Tuhan\nsumber kekuatan",
      "newGroup": true
    },
    {
      "type": "v",
      "text": "Kuasa-Mu tercurah\nbagiku senantiasa",
      "newGroup": true
    },
    {
      "type": "v",
      "text": "Dengan-Mu Tuhan\nku kan berjalan",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Dari kemuliaan\nsampai kemuliaan",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "S'lamanya",
      "newGroup": false
    }
  ]
}