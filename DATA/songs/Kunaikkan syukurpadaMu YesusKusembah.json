{
  "title": "Kunaikkan syukurpadaMu YesusKusembah",
  "lyrics": [
    {
      "type": "v",
      "text": "Kunaikkan syukur\npadaMu Yesus",
      "newGroup": true
    },
    {
      "type": "v",
      "text": "Kusembah sujud\nkepadaMu Tuhan",
      "newGroup": false
    },
    {
