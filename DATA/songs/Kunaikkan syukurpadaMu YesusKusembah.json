      "text": "Di hadapan tahta\nkemuliaanMu",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Kutinggikan kuagungkan\nselamanya",
      "newGroup": false
    },
    {
      "type": "c",
      "text": "Segala puji syukur\nbagiMu",
      "newGroup": true
    },
    {
      "type": "v",
      "text": "Kutinggikan\nnamaMu selalu",
      "newGroup": true
    },
    {
      "type": "v",
      "text": "Kemuliaan hanya bagiMu\nTerpujilah namaMu",
      "newGroup": false
    }
  ]
