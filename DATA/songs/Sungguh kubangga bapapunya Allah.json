{
  "title": "Sungguh kubangga bapapunya Allah",
  "lyrics": [
    {
      "type": "v",
      "text": "Sungguh kubangga bapa\npunya Allah seperti Engkau",
      "newGroup": true
    },
    {
      "type": "v",
      "text": "Sungguh kubangga Yesus\natas s'gala pengorbanan-Mu",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Tak ingin aku hidup\nlepas dari kasih-Mu",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "kasih-Mu menyelamatkan\nDan b'riku pengharapan",
      "newGroup": false
    },
    {
      "type": "c",
      "text": "kini ku persembahkan\napa yang aku miliki",
      "newGroup": true
    },
    {
      "type": "c",
      "text": "memang tiada berarti bila\ndibanding dengan kasih-Mu",
      "newGroup": false
    },
    {
      "type": "c",
      "text": "Namun ku ingin membri\ndengan sukacita dihati",
      "newGroup": false
    },
    {
      "type": "c",
      "text": "Kar'na kutahu ini\nmenyenangkan hati-mu",
      "newGroup": false
    }
  ]
}