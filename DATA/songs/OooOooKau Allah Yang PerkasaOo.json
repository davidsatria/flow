{
  "title": "OooOooKau Allah Yang PerkasaOo",
  "lyrics": [
    {
      "type": "c",
      "text": "Ooo...Ooo...\nKau Allah Yang Perkasa",
      "newGroup": true
    },
    {
      "type": "v",
      "text": "Ooo...Ooo...\nBerkuasa Dan Bertahta",
      "newGroup": true
    },
    {
      "type": "v",
      "text": "Ooo...Ooo...\nKau Allah Yang Perkasa",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Ooo...Ooo...\nKaulah Raja!",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Kami Puji Dengan Riang\nDikau Allah Yang Besar",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Bagai Bunga T’rima Siang\nHati Kami Pun Mekar",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Kabut Dosa Dan Derita,\nKebimbangan, T’lah Lenyap.",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Sumber Suka Yang Abadi,\nB’rikan Sinarmu Menyerap.",
      "newGroup": false
    },
    {
      "type": "c",
      "text": "Ooo...Ooo...\nKau Allah Yang Perkasa",
      "newGroup": true
    },
    {
      "type": "v",
      "text": "Ooo...Ooo...\nKaulah Raja!",
      "newGroup": true
    },
    {
      "type": "v",
      "text": "Kau Memb’ri\nKau Mengampuni,",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Kaulimpahkan\nRahmat-Mu.",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Sumber Air Hidup Ria,\nLautan Kasih Dan Restu.",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Yang Mau Hidup\nDalam Kasih",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Kaujadikan Milik-Mu",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Agar Kami Menyayangi\nMeneladani Kasih-Mu",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "ending\nOoo...Ooo...\nKau Allah Yang Perkasa",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Ooo...Ooo...\nKaulah Raja!",
      "newGroup": false
    }
  ]
}