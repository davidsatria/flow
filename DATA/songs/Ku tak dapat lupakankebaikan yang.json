{
  "title": "Ku tak dapat lupakankebaikan yang",
  "lyrics": [
    {
      "type": "v",
      "text": "Ku tak dapat lupakan,\nkebaikan yang kut'rima",
      "newGroup": true
    },
    {
      "type": "v",
      "text": "PengorbananMu yang mulia\njadikanku berharga",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Kau tulus menerima\naku apa adanya",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "kekuatan kasihMu nyata,\nmemulihkan hidupku",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Kau bukan Tuhan\nyang melihat rupa",
      "newGroup": false
    },
    {
      "type": "c",
      "text": "Kau bukan Tuhan\nyang memandang harta",
      "newGroup": true
    },
    {
      "type": "v",
      "text": "Hati hamba\nyang s'lalu Kau cari",
      "newGroup": true
    },
    {
      "type": "v",
      "text": "biar Kau temukan\ndi dalamku",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "S'lama kuhidup\nku mau menyembahMu",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "s'bab Engkau sangat\nberarti bagiku",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Yang terbaik\nyang ada padaku",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "ku persembahkan\nkepadaMu Yesusku",
      "newGroup": false
    }
  ]
}