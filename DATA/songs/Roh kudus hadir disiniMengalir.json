    },
    {
      "type": "v",
      "text": "Tiada yang mustahil\nBagi orang percaya",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Bila roh Allah turut bekerja\nDiantara kita",
      "newGroup": false
