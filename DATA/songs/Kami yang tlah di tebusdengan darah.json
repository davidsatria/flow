{
  "title": "Kami yang tlah di tebusdengan darah",
  "lyrics": [
    {
      "type": "v",
      "text": "Kami yang tlah di tebus\ndengan darah yang kudus",
      "newGroup": true
    },
    {
      "type": "v",
      "text": "Mengangkat\npujian bagiMu",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Kami bait kudusMu\nsbagai bukti karyaMu",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Nyatakan\nKau besar dan hidup",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Berlari sampai tujuan\nmendapatkan mahkota kekal",
      "newGroup": false
    },
    {
      "type": "c",
      "text": "Kami trima kuasaMu Tuhan",
      "newGroup": true
    },
    {
      "type": "v",
      "text": "Kami trima kemenangan\nyang Engkau sediakan",
      "newGroup": true
    },
    {
      "type": "v",
      "text": "Tuk kami bawa\ndi setiap langkah",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Dimanapun kami berdiri\nkemanapun kami pergi",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Di situ pasti\nmujizatMu terjadi",
      "newGroup": false
    }
  ]
}