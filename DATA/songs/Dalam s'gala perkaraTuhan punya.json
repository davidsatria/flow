{
  "title": "Dalam s'gala perkaraTuhan punya",
  "lyrics": [
    {
      "type": "v",
      "text": "Dalam sgala perkara\nTuhan punya rencana",
      "newGroup": true
    },
    {
      "type": "v",
      "text": "Yang lebih besar dari\nsemua yang terpikirkan",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Apapun yang Dia perbuat\ntak ada maksud jahat",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Sbab itu ku lakukan semua\ndenganMu Tuhan",
      "newGroup": false
    },
    {
      "type": "c",
      "text": "Ku tak akan menyerah\npada apapun juga",
      "newGroup": true
    },
    {
      "type": "c",
      "text": "Sebelum kucoba\nsemua yang kubisa",
      "newGroup": false
    },
    {
      "type": "c",
      "text": "tetapi kuberserah\nkepada kehendakMu",
      "newGroup": false
    },
    {
      "type": "c",
      "text": "Hatiku percaya\nTuhan punya rencana",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Aku masih punya Tuhan\nAku masih punya Tuhan",
      "newGroup": true
    },
    {
      "type": "v",
      "text": "punya pengharapan\nAku tetap beriman",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Tuhanku Yesus kekuatanku\nYesus kekuatanku",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Aku masih punya Tuhan",
      "newGroup": false
    }
  ]
