      "text": "Tuhan yang bersama kami",
      "newGroup": true
    },
    {
      "type": "c",
      "text": "Berjalan bersama kami",
      "newGroup": false
    },
    {
      "type": "c",
      "text": "Ku tak takut, ku tak gentar",
      "newGroup": false
    },
    {
      "type": "c",
      "text": "S'bab Allahku bersama kami",
      "newGroup": false
    },
    {
      "type": "c",
      "text": "Tuhan yang bersama kami",
      "newGroup": false
    },
    {
      "type": "c",
      "text": "Berjalan bersama kami",
      "newGroup": false
    },
    {
