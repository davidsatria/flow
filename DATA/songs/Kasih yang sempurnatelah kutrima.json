{
  "title": "Kasih yang sempurnatelah kutrima",
  "lyrics": [
    {
      "type": "v",
      "text": "Kasih yang sempurna\ntelah kutrima dariMu",
      "newGroup": true
    },
    {
      "type": "v",
      "text": "Bukan karena\nkebaikanku",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Hanya oleh kasih karuniaMu\nKau pulihkan aku",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "layakanku tuk\ndapat memanggilMu Bapa",
      "newGroup": false
    },
    {
      "type": "c",
      "text": "Kau b'ri yang kupinta\nsaatku mencari  kumendapatkan",
      "newGroup": true
    },
    {
      "type": "c",
      "text": "Kuketuk pintuMu\ndan Kau bukakan",
      "newGroup": false
    },
    {
      "type": "c",
      "text": "s'bab Kau Bapaku\nBapa yang kekal",
      "newGroup": false
    },
    {
      "type": "c",
      "text": "Takkan Kau biarkan\naku melangkah hanya sendirian",
      "newGroup": false
    },
    {
      "type": "c",
      "text": "Kau selalu ada bagiku",
      "newGroup": false
    },
    {
      "type": "c",
      "text": "s'bab Kau Bapaku\nBapa yang kekal",
      "newGroup": false
    }
  ]
