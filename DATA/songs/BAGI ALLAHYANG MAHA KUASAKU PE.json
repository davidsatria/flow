{
  "title": "Bagi allahyang maha kuasaku pe",
  "lyrics": [
    {
      "type": "v",
      "text": "Bagi allah\nYang maha kuasa",
      "newGroup": true
    },
    {
      "type": "v",
      "text": "Ku persembahkan\nS'luruh hidupku",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Kar'na kasih\nDan cinta-nya besar",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Di dalam s'tiap waktu",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Ku bersuka s'bab ku\nDi s'lamatkan dari\nKuasa maut",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Haleluya ku\nBersuka kar'na",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Kasih dan\nCinta-nya besar",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Haleluya ku\nBersuka kar'na",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Kasih dan\nCinta-nya besar",
      "newGroup": false
    },
    {
      "type": "c",
      "text": "Senang bila\nYesus bersamaku",
      "newGroup": true
    },
    {
      "type": "v",
      "text": "Senang segala\nBebanku hilang",
      "newGroup": true
    },
    {
      "type": "v",
      "text": "Senang hidupku\nS'lalu bahagia",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Haleluya ku\nBersuka kar'na",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Kasih dan\nCinta-nya besar",
      "newGroup": false
