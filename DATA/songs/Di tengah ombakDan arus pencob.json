{
  "title": "Di tengah ombakDan arus pencob",
  "lyrics": [
    {
      "type": "v",
      "text": "Di tengah ombak\nDan arus pencobaan",
      "newGroup": true
    },
    {
      "type": "v",
      "text": "Hampir terhilang\nTujuan arah hidupku",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Bagaikan kapal yang\nS'lalu diombang-ambingkan",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Mengharap kasih-Nya\nSeolah-olah tiada mampu",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Yesus perhatikan\nKehidupan tiap orang",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Yang sudah rusak dibetulkan\nDengan penuh kasih sayang",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Yesus perhatikan\nTiap tetesan air mata",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Dia mengenal hatimu yang\nPenuh penyesalan dosa",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Di tengah ombak\nDan arus pencobaan",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Hampir terhilang\nTujuan arah hidupku",
      "newGroup": false
    }
  ]
}