{
  "title": "Surga nyatakanKemuliaan Tuhan",
  "lyrics": [
    {
      "type": "v",
      "text": "Surga nyatakan\nKemuliaan Tuhan kita",
      "newGroup": true
    },
    {
      "type": "v",
      "text": "Tiada yang dapat\nmenyamai Engkau Tuhan",
      "newGroup": false
    },
    {
      "type": "c",
      "text": "Sampai selamanya\nAnak Domba bertakhta",
      "newGroup": true
    },
    {
      "type": "v",
      "text": "Ku datang bersujud\nMenyembah-Mu Tuhan",
      "newGroup": true
    },
    {
      "type": "v",
      "text": "Ku kan britakan\nKemuliaan Anak Domba",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Yang tlah berkurban\n'Tuk menebus manusia",
      "newGroup": false
    },
    {
      "type": "c",
      "text": "Sampai selamanya\nAnak Domba bertakhta",
      "newGroup": true
    },
    {
      "type": "v",
      "text": "Ku datang bersujud\nMenyembah-Mu Tuhan",
      "newGroup": true
    },
    {
      "type": "c",
      "text": "Forever You'll be,\nthe Lamb upon the Throne",
      "newGroup": true
    },
    {
      "type": "v",
      "text": "I gladly bow my knee,\nand worship You alone",
      "newGroup": true
    }
  ]
