{
  "title": "Firman-mu berkata kau besertakumaka",
  "lyrics": [
    {
      "type": "v",
      "text": "Firman-mu berkata\nKau besertaku",
      "newGroup": true
    },
    {
      "type": "v",
      "text": "Maka kuat\nRoh dan jiwaku",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Tangan-mu tuhan\nS'lalu kunantikan",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Di setiap langkah\nKu percaya",
      "newGroup": false
    },
    {
      "type": "c",
      "text": "Dengan sayap-mu\nKu akan terbang tinggi",
      "newGroup": true
    },
    {
      "type": "c",
      "text": "Di tengah badai hidup\nKu tak menyerah",
      "newGroup": false
    },
    {
      "type": "c",
      "text": "Kau kekuatan\nDan perlindungan bagiku",
      "newGroup": false
    },
    {
      "type": "c",
      "text": "Pertolonganku di tempat\nMaha tinggi",
      "newGroup": false
    },
    {
      "type": "c",
      "text": "Ku mengangkat tanganku\nAku berserah",
      "newGroup": false
    },
    {
      "type": "c",
      "text": "Kau kunantikan\nKau yang kusembah",
      "newGroup": false
    },
    {
      "type": "c",
      "text": "Yesusku\nRajaku",
      "newGroup": false
    }
  ]
}
