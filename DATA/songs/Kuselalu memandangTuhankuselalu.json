{
  "title": "Kuselalu memandangTuhankuselalu",
  "lyrics": [
    {
      "type": "v",
      "text": "Kuselalu memandang\nTuhan\nkuselalu memujiMu",
      "newGroup": true
    },
    {
      "type": "v",
      "text": "Kupercaya\nkepada Tuhan\nkuberpasrah kepadaMu",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Siang malam\nkuingat Tuhan\nkar'na Tuhan\npelindungku",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Sebab Dia\nkutakkan gentar\nmenghadapi\nsemua musuh",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Kiri kananku\nada Tuhan\nseklilingku\nada Tuhan",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Dalam hidupku\nada Tuhan\nYesus s'lalu\nbersamaku",
      "newGroup": false
    }
  ]
}