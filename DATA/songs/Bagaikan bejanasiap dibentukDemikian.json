{
  "title": "Bagaikan bejanasiap dibentukDemikian",
  "lyrics": [
    {
      "type": "v",
      "text": "Bagaikan bejana\nsiap dibentuk",
      "newGroup": true
    },
    {
      "type": "v",
      "text": "Demikian hidupku\nditangan-Mu",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Dengan urapan kuasa Roh-Mu\nku dibaharui selalu",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Jadikan ku alat\ndalam rumah-Mu",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Inilah hidupku\nditangan-Mu",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Bentuklah sturut\nkehendak-Mu",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Pakailah sesuai\nrencana-Mu",
      "newGroup": false
    },
    {
      "type": "c",
      "text": "Ku mau sperti-Mu Yesus\ndisempurnakan selalu",
      "newGroup": true
    },
    {
      "type": "c",
      "text": "Dalam segenap jalanku\nmemuliakan Nama-Mu",
      "newGroup": false
    }
  ]
}