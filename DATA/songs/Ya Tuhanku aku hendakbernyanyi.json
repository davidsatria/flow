{
  "title": "Ya Tuhanku aku hendakbernyanyi",
  "lyrics": [
    {
      "type": "v",
      "text": "Ya Tuhanku aku hendak\nbernyanyi bagi-Mu",
      "newGroup": true
    },
    {
      "type": "v",
      "text": "Selama ku hidup",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Ya Allahku aku hendak\nbermazmur bagi-Mu",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Selagi ku ada",
      "newGroup": false
    },
    {
      "type": "c",
      "text": "Inilah yang kurenungkan\nsetiap waktu",
      "newGroup": true
    },
    {
      "type": "c",
      "text": "Nyanyian pujian\ndan pengagungan kepadaMu",
      "newGroup": false
    },
    {
      "type": "c",
      "text": "Biarlah manis Kau dengar Tuhan\nmanis Kau dengar Tuhan",
      "newGroup": false
    },
    {
      "type": "c",
      "text": "Dan hatiku bersuka\nkar'naMu",
      "newGroup": false
    }
  ]
}