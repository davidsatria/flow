{
  "title": "Tak hentinya perkenananMuMengalir",
  "lyrics": [
    {
      "type": "v",
      "text": "Tak hentinya perkenananMu",
      "newGroup": true
    },
    {
      "type": "v",
      "text": "Mengalir t'rus melingkupiku",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Oleh anugerahMu",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Karunia indah t’lah Kau b’rikan",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Kau layakkan dan sempurnakan",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Oleh anugerahMu",
      "newGroup": false
    },
    {
      "type": "c",
      "text": "Hanya oleh anugerahMu\nBerlimpah di hidupku",
      "newGroup": true
    },
    {
      "type": "v",
      "text": "Mahkota mulia Ku t'rima dari-Mu",
      "newGroup": true
    },
    {
      "type": "v",
      "text": "Hanya oleh anugerahMu",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Kau angkat dan celikkanku",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Bersyukur s’lalu Ubahku jadi baru",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Oleh anugerahMu",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Ku tenang dalam kedamaian",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Ku bersyukur t'lah dibebaskan",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Oleh anugerahMu",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Pengampunan-Mu pulihkanku",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Dalam Kristus, ku dikuduskan",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Oleh anugerahMu",
      "newGroup": false
    },
    {
      "type": "b",
      "text": "Hidupku, seg’nap hidupku\nMulia bagiMu, Rajaku",
      "newGroup": true
    },
    {
      "type": "v",
      "text": "Kuingin dan kurindukan\nKu t’lah Kau temukan",
      "newGroup": true
    },
    {
      "type": "v",
      "text": "BerkatMu melimpah",
      "newGroup": false
    }
  ]
}