{
  "title": "DIBERKATILAH ORANGYANG MENGANDALKAN",
  "lyrics": [
    {
      "type": "c",
      "text": "DIBERKATILAH ORANG\nYANG MENGANDALKAN TUHAN",
      "newGroup": true
    },
    {
      "type": "v",
      "text": "DIBERKATILAH ORANG\nYANG MENGANDALKAN TUHAN",
      "newGroup": true
    },
    {
      "type": "v",
      "text": "DIBERKATILAH ORANG\nYANG MENGANDALKAN TUHAN",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "YANG MENARUH HARAPNYA\nHANYA KEPADA TUHAN",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "AKAN SEPERTI POHON\nYANG TAK PERNAH KERING",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "YANG TETAP TUMBUH\nDAN MENGHASILKAN BUAH",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "DEMIKIAN HIDUP KITA\nSETIA MENGIRING DIA",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "KITA KAN BERSAMA DIA\nS'LAMANYA..",
      "newGroup": false
    },
    {
      "type": "b",
      "text": "ANDALKANLAH TUHAN\nDALAM HIDUPMU S'LALU..",
      "newGroup": true
    },
    {
      "type": "v",
      "text": "MAKA BERKATNYA\nKAN MENGALIR DALAMMU...",
      "newGroup": true
    }
  ]
}