{
  "title": "Janji-Mu Seperti Fajar",
  "lyrics": [
    {
      "type": "v",
      "text": "Ketika kuhadapi kehidupan ini\nJalan mana yang harus kupilih",
      "newGroup": true
    },
    {
      "type": "v",
      "text": "Ku tahu ku tak mampu\nKu tahu ku tak sanggup",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Hanya Kau Tuhan\ntempat jawabanku",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Aku pun tahu\nku tak pernah sendiri",
      "newGroup": true
    },
    {
      "type": "v",
      "text": "S'bab Engkau Allah\nyang menggendongku",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Tangan-Mu membelaiku\nCinta-Mu memuaskanku",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Kau mengangkatku\nke tempat yang tinggi",
      "newGroup": false
    },
    {
      "type": "c",
      "text": "Janji-Mu seperti fajar pagi hari\nYang tiada pernah terlambat bersinar",
      "newGroup": true
    },
    {
      "type": "c",
      "text": "Cinta-Mu seperti sungai yang mengalir\nDan ku tahu betapa dalam kasih-Mu",
      "newGroup": false
    }
  ]
}