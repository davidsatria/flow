{
  "title": "Tuhan HadirDi Bait Kudus-NyaSaat",
  "lyrics": [
    {
      "type": "v",
      "text": "Tuhan Hadir Di Bait Kudus-Nya\nSaat Umat Mencari Wajah-Nya",
      "newGroup": true
    },
    {
      "type": "v",
      "text": "Berseru Berdoa Bersujud Menyembah\nDan Menikmati Kehadiran-Nya",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Tuhan Mau Dekat\nDengan Umat-Nya",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Yang Datang Dengan\nSeg'nap Hatinya",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Berseru Berdoa Bersujud Menyembah\nDan Menikmati Kehadiran-Nya",
      "newGroup": false
    },
    {
      "type": "c",
      "text": "Hadirat-Mu Memenuhiku\nHadirat Kudus-Mu Penuhi Bait-Mu",
      "newGroup": true
    },
    {
      "type": "c",
      "text": "Dan Kutersungkur\nMenyembah-Mu",
      "newGroup": false
    },
    {
      "type": "c",
      "text": "Yang Kunampak\nHanya Kemuliaan-Mu",
      "newGroup": false
    }
  ]
