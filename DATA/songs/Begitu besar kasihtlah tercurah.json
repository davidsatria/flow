{
  "title": "Begitu besar kasihtlah tercurah",
  "lyrics": [
    {
      "type": "v",
      "text": "Begitu besar kasih\ntlah tercurah bagi dunia",
      "newGroup": true
    },
    {
      "type": "v",
      "text": "KaryaMu kasihMu\nyang termulia",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Tiada terselami besar\ndan ajaib perbuatanMu",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Kau beri hidupMu bagi diriku",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Tiada yang sepertiMu\nKau berkuasa slamanya",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Kupuji Kau selalu",
      "newGroup": false
    },
    {
      "type": "c",
      "text": "Oh betapa dalamnya\nBetapa lebarnya kasih setiaMu",
      "newGroup": true
    },
    {
      "type": "c",
      "text": "Oh tiada bandingannya\ntiada duanya",
      "newGroup": false
    },
    {
      "type": "c",
      "text": "Tiada sperti Kau\nYesus Tuhanku",
      "newGroup": false
    }
  ]
}