      "text": "Bapa yang kekal\nmaha kuasa",
      "newGroup": false
    },
    {
      "type": "v",
      "text": "Kau disanjung sembah s'lamanya\nSurga bumipun serukan",
      "newGroup": false
    },
    {
      "type": "c",
      "text": "Haleluya... haleluya\nOh kudus-kuduslah Tuhan",
      "newGroup": true
    },
    {
      "type": "c",
      "text": "Haleluya...haleluya\nterpujilah nama Tuhan",
